# Netlify header rules. Lives in public/ so it is copied into dist/ by Vite and
# applies to both git-based builds and manual dist uploads.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# Vite emits content-hashed filenames under /assets, so they can be cached
# permanently. The deployed site currently sends max-age=0,must-revalidate,
# which forces a revalidation round-trip for every asset on every visit.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# Icons and social images change rarely but are not content-hashed.
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/og-image.png
  Cache-Control: public, max-age=604800

# The HTML shell must stay revalidated so new builds are picked up immediately.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600
