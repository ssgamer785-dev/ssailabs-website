# =============================================================================
# Regency Tailor — environment
#
# Only the publishable anon key belongs in a browser build. The Supabase
# service-role key bypasses Row Level Security entirely and must never appear
# here, in .env.local, or anywhere else the front end can read.
# =============================================================================

# Supabase project (Settings → API in the Supabase dashboard)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Persistence mode.
#   unset / anything else  → Supabase (production; sign-in required)
#   local                  → browser storage, no sign-in. Development and the
#                            end-to-end test suite only. Never for real client
#                            data: it is single-machine and unauthenticated.
# VITE_PERSISTENCE="local"
