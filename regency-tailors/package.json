{
  "name": "react-example",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/run.mjs",
    "dev:local": "VITE_PERSISTENCE=local vite --port=3000 --host=0.0.0.0",
    "test:db": "./supabase/tests/run-tests.sh",
    "test:auth-gate": "node e2e/auth-gate.mjs",
    "test:bill": "node e2e/order-bill.mjs",
    "test:order-uuid": "node e2e/order-uuid.mjs",
    "test:consistency": "node e2e/consistency.mjs",
    "test:integrity": "node e2e/integrity.mjs",
    "electron:dev": "npm run build && electron electron/main.cjs",
    "electron:pack": "npm run build && electron-builder --win dir --x64",
    "electron:build:win": "npm run build && electron-builder --win nsis --x64",
    "electron:verify": "npm run build && electron electron/verify.cjs",
    "test:new-garments": "node e2e/new-garments.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.7"
  },
  "description": "Regency Tailor — bespoke showroom and tailoring suite",
  "author": "S.S Ai Labs",
  "main": "electron/main.cjs"
}
