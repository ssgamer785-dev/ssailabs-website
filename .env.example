# Owner Email & SMTP settings for project inquiries
OWNER_EMAIL="contact.ssailabs@gmail.com"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Supabase (The Traders Planet App backend — see supabase/README.md)
# Project URL and anon/public key from Settings > API in your Supabase project.
# Safe to expose client-side: every table it can reach is locked down by the RLS
# policies in supabase/migrations/. Never put the service_role key in a VITE_*
# variable or any other client-bundled file.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_ANON_PUBLIC_KEY"

# --- Server-only. Never prefix these with VITE_ (that would bundle them into
# --- the browser build). They are read by server/chat-media.ts.

# Service-role key from Settings > API. Bypasses RLS — used only after the
# caller's own JWT has been verified.
SUPABASE_SERVICE_ROLE_KEY=""

# Cloudflare R2 bucket for chat media (images, video, PDFs, voice notes).
# Keep the bucket PRIVATE: the app serves it through short-lived signed URLs.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="traders-planet-chat"

# PWA Web Push (server-only; do not prefix with VITE_). Generate one VAPID key
# pair and keep it stable across deployments so existing subscriptions survive.
# Run: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:your-support-address@example.com"
# A random secret shared with the Supabase notifications INSERT webhook header.
PUSH_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# The single admin's sign-in (server-only — never VITE_-prefixed, so these
# cannot reach the browser bundle).
#
# ADMIN_USERNAME is the alias typed on the Admin Login screen. Which Supabase
# account it resolves to is discovered from the single profile with
# role='admin', so there is no second place for the two to drift apart. If the
# database has no admin, or more than one, sign-in refuses rather than guessing.
#
# It is NOT the only variable admin sign-in needs. Discovering that profile
# takes SUPABASE_SERVICE_ROLE_KEY above, and signing in takes the Supabase URL
# and anon key. All four must be non-empty or /api/admin/login answers 503
# "Admin sign-in is not configured on this server." — and names the missing
# ones in the server log. A variable set to an empty string counts as unset.
#
# There is no ADMIN_EMAIL and no ADMIN_PASSWORD, by design. The password lives
# in Supabase Auth, which stores a bcrypt hash and rate-limits failed attempts,
# and is set in the Supabase dashboard. Nothing in this repository stores it,
# reads it, or sees it at rest.
# ---------------------------------------------------------------------------
ADMIN_USERNAME="your-admin-username"

# ---------------------------------------------------------------------------
# Google sign-in
#
# There is nothing to put here, deliberately. "Continue with Google" calls
# supabase.auth.signInWithOAuth(), which sends the user to Supabase; Supabase
# holds the Google client ID and secret and talks to Google itself. The browser
# never sees either, and neither does this file.
#
# Configure it in the Supabase dashboard instead:
#   Authentication > Providers > Google   — client ID + secret from Google Cloud
#   Authentication > URL Configuration    — add <your origin>/login to the
#                                           allowed redirect URLs, because that
#                                           is where signInWithGoogle() returns
#
# A Google user is NOT exempt from the activation gate: handle_new_user()
# creates their profile with activated_at NULL exactly as it does for an email
# signup, so they meet /activate on the same terms as everyone else.
# ---------------------------------------------------------------------------
